{
  "manifest_version": 3,
  "name": "SpeakX — Text to Speech for X",
  "short_name": "SpeakX",
  "version": "1.0.0",
  "description": "Listen to posts, threads, and replies on X. One click. Your voices. Nothing uploaded.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SpeakX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "speak-post": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Speak the current post"
    },
    "stop-speaking": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop speaking"
    }
  }
}
